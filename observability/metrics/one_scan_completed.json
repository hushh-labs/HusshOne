{
  "description": "Count of completed One scans, labelled by intelligence source. Sources: one.scan.completed and one.research.completed structured logs.",
  "filter": "resource.type=\"cloud_run_revision\" resource.labels.service_name=\"one\" (jsonPayload.event=\"one.scan.completed\" OR jsonPayload.event=\"one.research.completed\")",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "labels": [
      { "key": "source", "valueType": "STRING" },
      { "key": "mode", "valueType": "STRING" }
    ]
  },
  "labelExtractors": {
    "source": "EXTRACT(jsonPayload.source)",
    "mode": "EXTRACT(jsonPayload.mode)"
  }
}
