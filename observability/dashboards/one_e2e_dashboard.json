{
  "displayName": "one.hushh.ai E2E",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0, "yPos": 0, "width": 6, "height": 4,
        "widget": {
          "title": "one — requests/s by response class",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"one\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"response_code_class\""] }
                }
              },
              "plotType": "LINE"
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 0, "width": 6, "height": 4,
        "widget": {
          "title": "one — request latency p50/p95/p99 (ms)",
          "xyChart": {
            "dataSets": [
              { "legendTemplate": "p50", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"one\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_50" } } }, "plotType": "LINE" },
              { "legendTemplate": "p95", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"one\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95" } } }, "plotType": "LINE" },
              { "legendTemplate": "p99", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"one\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_99" } } }, "plotType": "LINE" }
            ]
          }
        }
      },
      {
        "xPos": 0, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "one — container instance count",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"one\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_MEAN", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"state\""] } } },
              "plotType": "STACKED_AREA"
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Shadow API (RIA) — requests/s by response class",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"hushh-ria-intelligence-api\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"response_code_class\""] } } },
              "plotType": "LINE"
            }]
          }
        }
      },
      {
        "xPos": 0, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Shadow API (RIA) — request latency p50/p95/p99 (ms)",
          "xyChart": {
            "dataSets": [
              { "legendTemplate": "p50", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"hushh-ria-intelligence-api\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_50" } } }, "plotType": "LINE" },
              { "legendTemplate": "p95", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"hushh-ria-intelligence-api\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95" } } }, "plotType": "LINE" }
            ]
          }
        }
      },
      {
        "xPos": 6, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Shadow API (RIA) — instance count (min=1 always-on)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"hushh-ria-intelligence-api\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_MEAN", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"state\""] } } },
              "plotType": "STACKED_AREA"
            }]
          }
        }
      },
      {
        "xPos": 0, "yPos": 12, "width": 6, "height": 4,
        "widget": {
          "title": "Scans completed by source (one.scan.completed)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/one_scan_completed\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"source\""] } } },
              "plotType": "STACKED_BAR"
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 12, "width": 6, "height": 4,
        "widget": {
          "title": "Scan duration p50/p95 (one, ms)",
          "xyChart": {
            "dataSets": [
              { "legendTemplate": "p50", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/one_scan_duration_ms\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "600s", "perSeriesAligner": "ALIGN_PERCENTILE_50" } } }, "plotType": "LINE" },
              { "legendTemplate": "p95", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/one_scan_duration_ms\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "600s", "perSeriesAligner": "ALIGN_PERCENTILE_95" } } }, "plotType": "LINE" }
            ]
          }
        }
      },
      {
        "xPos": 0, "yPos": 16, "width": 6, "height": 4,
        "widget": {
          "title": "Shadow API duration p50/p95 (RIA, ms)",
          "xyChart": {
            "dataSets": [
              { "legendTemplate": "p50", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/ria_shadow_duration_ms\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "600s", "perSeriesAligner": "ALIGN_PERCENTILE_50" } } }, "plotType": "LINE" },
              { "legendTemplate": "p95", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/ria_shadow_duration_ms\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "600s", "perSeriesAligner": "ALIGN_PERCENTILE_95" } } }, "plotType": "LINE" }
            ]
          }
        }
      },
      {
        "xPos": 6, "yPos": 16, "width": 6, "height": 4,
        "widget": {
          "title": "Errors — scan errors + Shadow 5xx",
          "xyChart": {
            "dataSets": [
              { "legendTemplate": "one scan errors", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/one_scan_errors\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_SUM" } } }, "plotType": "LINE" },
              { "legendTemplate": "RIA shadow 5xx", "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/ria_shadow_errors\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_SUM" } } }, "plotType": "LINE" }
            ]
          }
        }
      },
      {
        "xPos": 0, "yPos": 20, "width": 12, "height": 4,
        "widget": {
          "title": "User funnel — events by UI stage (one.ui.*)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/one_ui_funnel\" resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "3600s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"ui_event\""] } } },
              "plotType": "STACKED_BAR"
            }]
          }
        }
      }
    ]
  }
}
