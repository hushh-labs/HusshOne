{
  "displayName": "[one.hushh.ai] scan error spike",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "one_scan_errors > 3 in 5m",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" metric.type=\"logging.googleapis.com/user/one_scan_errors\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 3,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["projects/hushone-app/notificationChannels/4619923041387238844"],
  "enabled": true
}
