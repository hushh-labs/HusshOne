{
  "displayName": "[Shadow API] hushh-ria-intelligence-api 5xx on /v1/hushh-shadow/report",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "RIA shadow 5xx count > 2 in 5m",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" metric.type=\"logging.googleapis.com/user/ria_shadow_errors\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": ["projects/hushone-app/notificationChannels/4619923041387238844"],
  "enabled": true
}
