{
  "name": "one-hushh-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-onboarding-kit.mjs",
    "build": "next build",
    "build:kit": "node scripts/build-onboarding-kit.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prod": "node scripts/prod-smoke.mjs",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "test:burst": "vitest run src/lib/burst src/app/api/one/burst src/app/.well-known src/lib/db/burst-store.test.ts",
    "test:burst:coverage": "vitest run src/lib/burst src/app/api/one/burst src/app/.well-known src/lib/db/burst-store.test.ts --coverage --coverage.provider=v8 --coverage.include=src/lib/burst/** --coverage.include=src/app/api/one/burst/** --coverage.include=src/app/.well-known/** --coverage.include=src/lib/db/burst-store.ts --coverage.reporter=text",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/client": "^6.19.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^9.15.1",
    "next": "16.2.7",
    "nodemailer": "^8.0.10",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
