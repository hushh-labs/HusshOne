generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OneUser {
  id          String         @id @default(uuid()) @db.Uuid
  firebaseUid String         @unique
  email       String
  name        String?
  photoUrl    String?
  provider    String         @default("google")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  consents    ConsentEvent[]
  scanRuns    ScanRun[]
  dataRequests DataRequest[]
  notifications OneNotification[]
  linkedInConnection LinkedInConnection?
  socialConnections SocialConnection[]
  socialAccessRequests SocialAccessRequest[]
  socialContentItems SocialContentItem[]
  socialMediaAssets SocialMediaAsset[]
  socialRefreshJobs SocialRefreshJob[]
  preferenceProfile UserPreferenceProfile?
  preferenceRunLogs SocialPreferenceRunLog[]
  chatGptContextSnapshots ChatGptContextSnapshot[]

  @@index([email])
}

// User-approved ChatGPT context imports. OpenAI does not give One raw chat
// history or memory access; this stores only summaries the user explicitly asks
// ChatGPT to save into one.hushh.ai.
model ChatGptContextSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  summary     String
  categories  Json
  source      String   @default("chatgpt_user_approved_summary")
  capturedVia String   @default("openai_connector")
  userPrompt  String?
  consentText String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([source])
}

// Optional connected social profiles (Instagram first). These are supporting public
// context anchors; LinkedIn remains the mandatory identity/career ground truth.
model SocialConnection {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  platform     String
  publicId     String
  profile      Json
  sessionValid Boolean  @default(true)
  connectedAt  DateTime @default(now())
  refreshedAt  DateTime @updatedAt
  user         OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, publicId])
  @@index([userId, platform])
}

// Durable private-profile access lifecycle for optional social enrichment. The
// worker may request access once; One stores pending/approved state without
// blocking the mandatory LinkedIn-first scan path.
model SocialAccessRequest {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  platform        String
  publicId        String
  profileUrl      String
  status          String
  profileSnapshot Json?
  requestedAt     DateTime?
  approvedAt      DateTime?
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime?
  attemptCount    Int      @default(0)
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, publicId])
  @@index([userId, platform, status])
  @@index([nextCheckAt])
}

// Indexed visible social posts/replies/media context. This is the app-facing
// source-of-truth ledger; larger timeline/vector backends can mirror from here.
model SocialContentItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  platform    String
  publicId    String
  itemId      String
  itemUrl     String
  itemType    String
  text        String?
  timestamp   DateTime?
  media       Json?
  metrics     Json?
  features    Json?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  user        OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, itemId])
  @@index([userId, platform, timestamp])
  @@index([userId, lastSeenAt])
}

// Safe media-analysis metadata. Never store cookies, localStorage, browser
// secrets, or private fetch material here.
model SocialMediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  platform    String
  assetHash   String
  sourceUrl   String
  cacheUri    String?
  analysis    Json?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  user        OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, assetHash])
  @@index([userId, platform])
}

// Queue/lock row for keeping connected socials fresh after the first scan.
model SocialRefreshJob {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  platform    String
  publicId    String
  status      String   @default("queued")
  priority    Int      @default(0)
  attempts    Int      @default(0)
  lockedAt    DateTime?
  nextRunAt   DateTime @default(now())
  lastError   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt, priority])
  @@index([userId, platform, publicId])
}

// Latest derived preference graph shown at the top of the One dossier.
model UserPreferenceProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  scanRunId   String?  @db.Uuid
  status      String   @default("completed")
  version     String
  inputHash   String?
  profile     Json
  generatedAt DateTime @default(now())
  staleAfter  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanRun     ScanRun? @relation(fields: [scanRunId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([staleAfter])
}

// The user's connected LinkedIn (full profile) from the MCP "Connect LinkedIn" step.
// 1:1 with OneUser so a returning session re-scans with the ground truth without
// re-logging into LinkedIn. sessionValid flips false when the server session expires
// (→ the app routes the user back to re-connect).
model LinkedInConnection {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  profile      Json
  publicId     String?
  sessionValid Boolean  @default(true)
  connectedAt  DateTime @default(now())
  refreshedAt  DateTime @updatedAt
  user         OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConsentEvent {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  purpose        String
  consentVersion String
  locationMode   String
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  zipCode        String?
  ipHash         String?
  userAgentHash  String?
  createdAt      DateTime @default(now())
  user           OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ScanRun {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  status          String     @default("running")
  mode            String
  purpose         String
  input           Json
  normalizedResult Json?
  summary         String?
  error           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?
  // Observability: per-phase timing + how the scan ended. Populated on
  // completion / recovery / deadline-handoff so we can report, per user, how long
  // Phase-1 (Gemini) and Phase-2 (Opus synth) took and why a scan did or didn't
  // deliver. Nullable: old rows + in-flight scans have none. See scan-timings skill.
  phase1Ms          Int?
  phase2Ms          Int?
  totalMs           Int?
  outcome           String? // completed | completed_via_recovery | deadline | failed
  deepResearchJobId String?
  sessionId         String?
  user            OneUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditJobs       AuditJob[]
  notifications   OneNotification[]
  preferenceProfiles UserPreferenceProfile[]
  preferenceRunLogs SocialPreferenceRunLog[]

  @@index([userId, createdAt])
  @@index([status])
}

// Per-run audit trail for the optional social preference layer. This keeps
// selection/debug metadata outside the main dossier while preserving the answer
// to "which evidence/signals were selected for this scan?"
model SocialPreferenceRunLog {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  scanRunId           String?  @db.Uuid
  status              String
  event               String
  version             String?
  inputHash           String?
  platforms           Json?
  counts              Json?
  selectedEvidenceIds Json?
  selectedSignalIds   Json?
  durationMs          Int?
  error               String?
  createdAt           DateTime @default(now())
  user                OneUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanRun             ScanRun? @relation(fields: [scanRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([scanRunId, createdAt])
  @@index([status, event])
}

model AuditJob {
  id              String    @id @default(uuid()) @db.Uuid
  scanRunId       String    @db.Uuid
  upstreamJobId   String    @unique
  status          String
  totalShards     Int       @default(0)
  completedShards Int       @default(0)
  failedShards    Int       @default(0)
  reportAvailable Boolean   @default(false)
  report          Json?
  errors          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  scanRun         ScanRun   @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([scanRunId])
  @@index([status])
}

model DataRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  type        String
  status      String    @default("requested")
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  user        OneUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([type, status])
}

model OneNotification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String?   @db.Uuid
  scanRunId         String    @db.Uuid
  notificationType  String
  recipientEmail    String
  subject           String
  status            String    @default("pending")
  provider          String    @default("gmail")
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?
  user              OneUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  scanRun           ScanRun   @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@unique([scanRunId, notificationType, recipientEmail])
  @@index([userId, createdAt])
  @@index([status])
}
