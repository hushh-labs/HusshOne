NWS_ENVIRONMENT=development
# Use a secret-manager value in production. Never expose a production key to browser JavaScript.
NWS_API_KEY=local-development-only
NWS_REQUIRE_API_KEY=true
NWS_RATE_LIMIT_PER_MINUTE=60
NWS_MAX_REQUEST_BYTES=32768
NWS_QUERY_LOCATION_DECIMALS=2
NWS_DATA_MODE=VERIFIED_PUBLIC_BOOTSTRAP
