# Server
PORT=8080
HOST=127.0.0.1
APP_ENV=production

# Cloud SQL (the Auth Proxy is started automatically when it is installed).
# Keep DATABASE_URL unset in production. The secure default rejects direct
# URLs and unowned/manual proxies, so this app can only use its dedicated
# Google identity. Keep passwords out of this file; Secret Manager is used by
# default.
DB_BACKEND=cloud
ALLOW_UNMANAGED_CLOUD_SQL_CONNECTION=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hotel_scraper
# Replace with the reviewed least-privilege writer role when it is created.
DB_USER=directories
DB_PASSWORD_SECRET=directories-db-password
AUTO_START_PROXY=true
CLOUD_SQL_PROXY_PATH=
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# GCP / Cloud SQL context
GCP_PROJECT=hushh-tech-prod
GCP_REGION=us-central1
CLOUD_SQL_INSTANCE=hushh-directories-db

# Dedicated, project-only Google user credential store. Run
# .\setup_dedicated_gcloud_account.ps1 once before the first Cloud SQL
# preflight. These settings are consumed only by this app; they do not change
# the normal gcloud identity in other terminals.
GCP_GCLOUD_CONFIG_NAME=husshone-scraper
GCP_GCLOUD_ACCOUNT=husshpuppy5@gmail.com
# Leave blank to use %LOCALAPPDATA%\HusshOne-Hotel-Scraper\gcloud.
GCP_GCLOUD_CONFIG_DIR=

# Maps worker safety controls
SCRAPER_DELAY_SEC=3
MAPS_MAX_RESULTS=50
ZIP_MAX_DISTANCE_KM=75
ZIP_MAX_NEW_HOTELS=40
DAILY_MAPS_CALL_CAP=1000
CAPTCHA_BACKOFF_1_SEC=300
CAPTCHA_BACKOFF_2_SEC=900
CAPTCHA_BACKOFF_3_SEC=3600
SCRAPER_PROCESS_TIMEOUT_SEC=600
CHROME_RECYCLE_AFTER_ZIPS=200
CHROME_CLEAR_CACHE_ON_RECYCLE=true
DB_OFFLINE_RETRY_SEC=30

# Leave empty until a known-good high-volume canary ZIP is selected.
CANARY_ZIP=
CANARY_INTERVAL_SEC=10800
CANARY_MIN_RESULTS=3
SCHEMA_GUARD_ENABLED=true
SCHEMA_GUARD_CACHE_SEC=300

# Durable local recovery and read-only maintenance.
OUTBOX_RETENTION_DAYS=14
OUTBOX_PRUNE_INTERVAL_SEC=3600
DATA_QUALITY_AUDIT_INTERVAL_SEC=86400
DATA_QUALITY_AUDIT_SCAN_LIMIT=10000
DATA_QUALITY_AUDIT_FINDING_LIMIT=100

# Optional stale-refresh policy. Zero leaves completed ZIPs alone.
REFRESH_AFTER_DAYS=30
WEBSITE_ENRICHMENT_ENABLED=true
WEBSITE_BROWSER_FALLBACK=true
WEBSITE_AUTONOMOUS=true
WEBSITE_DISCOVERY_BACKFILL=true
WEBSITE_BACKFILL_AUTO_START=true
WEBSITE_BACKFILL_REFRESH_SEC=86400
WEBSITE_MAX_PAGES=4
WEBSITE_TIMEOUT_SEC=10
WEBSITE_MAX_BYTES=1000000
WEBSITE_MAX_ATTEMPTS=3
WEBSITE_FILL_MISSING_FIELDS=true
WEBSITE_BACKFILL_BATCH_SIZE=200
WEBSITE_BACKFILL_MAX_PENDING=100
WEBSITE_JOBS_PER_CYCLE=8
WEBSITE_CYCLE_BUDGET_SEC=45
WEBSITE_BACKLOG_HIGH=200
WEBSITE_BACKLOG_LOW=100
# Set to 1 when training needs maximum CPU/RAM headroom; never exceeds 2.
WEBSITE_FETCH_CONCURRENCY=2
WEBSITE_MIN_FREE_RAM_GB=4

# Imported hotel mapping uses local Chrome, never the paid Places transport.
VM_USE_IMPORTED_HOTEL_PIPELINE=true
# Bulk NPPES/SEC downloads require disk headroom. Registry workers are opt-in.
VM_MIN_FREE_DISK_GB=20
