# Production build-time config — PUBLIC values only (safe to commit).
# Firebase WEB config is client-side public by design; fetched from Firebase
# project `hushone-app` (web app "Hushh Web"). These get inlined by `next build`.
# Runtime SECRETS (DATABASE_URL, FIREBASE_ADMIN_CREDENTIALS_JSON, API keys) are
# injected by Cloud Run from Secret Manager — never put them here.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBhVS4cg9lNPU6_9PaHM6pgAY-3LZAD9Us
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=one.hushh.ai
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hushone-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hushone-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=53407187172
NEXT_PUBLIC_FIREBASE_APP_ID=1:53407187172:web:6b59047a3c10d61db32cf1

# Dev auth MUST stay false in production (no DEV_TOKEN bypass).
NEXT_PUBLIC_ONE_ENABLE_DEV_AUTH=false

# Deep Research mode: powers the number→scan flow with the Deep Research API
# (markdown dossier). Build-time flag, inlined by next build. The runtime
# DEEP_RESEARCH_API_TOKEN secret is injected by Cloud Run from Secret Manager.
NEXT_PUBLIC_ONE_RESEARCH_MODE=true

# Public site URL — used for emailed report links when the request origin is
# unavailable. ONE_SITE_URL is read server-side at runtime; the NEXT_PUBLIC_ copy
# is inlined for any client use. Also set as a Cloud Run env var on deploy.
ONE_SITE_URL=https://one.hushh.ai
NEXT_PUBLIC_ONE_SITE_URL=https://one.hushh.ai
